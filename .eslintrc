{
  "extends": "eslint:recommended",
  "env": {
    "browser": true,
    "commonjs": true,
    "node": true,
    "es6": true,
    "jquery": true,
    "jest": true
  },
  "rules": {
        "consistent-return": 2,
        "indent"           : [1, 4],
        "semi"             : [1, "always"],
        "prefer-const": "error"
  }
}